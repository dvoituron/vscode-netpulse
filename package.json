{
  "name": "dotnet-pulse",
  "displayName": ".NET Pulse",
  "description": "Enhanced .NET development workflow with smart project building, code-behind navigation, git tools, and external terminal integration",
  "version": "1.0.13",
  "icon": "icon.png",
  "publisher": "dvoituron",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvoituron/vscode-netpulse"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionPack": [
    "ms-vscode.vs-keybindings",
    "vscode-icons-team.vscode-icons",
    "ms-dotnettools.csdevkit",
    "usernamehw.errorlens"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": ".NET Pulse",
      "properties": {
        "externalTerminal.path": {
          "type": "string",
          "default": "wt.exe",
          "description": "Path to the external terminal executable (e.g., wt.exe for Windows Terminal)"
        },
        "dotnetPulse.projectUri": {
          "type": "string",
          "default": "",
          "description": "Relative path to the .NET project file to build and run (e.g., MySample/MySample.csproj)"
        },
        "dotnetPulse.runArgs": {
          "type": "array",
          "default": [],
          "description": "Command line arguments to pass to the application when running or debugging",
          "items": {
            "type": "string"
          }
        },
        "dotnetPulse.buildArgs": {
          "type": "array",
          "default": [],
          "description": "Command line arguments to pass to dotnet build for Build Project and Build Solution",
          "items": {
            "type": "string"
          }
        },
        "dotnetPulse.runBuildArgs": {
          "type": "array",
          "default": [],
          "description": "Command line arguments to pass to dotnet build before running or debugging",
          "items": {
            "type": "string"
          }
        },
        "dotnetPulse.projectPreLaunchTask": {
          "type": "string",
          "default": "",
          "description": "Name of a VS Code task to run before launching the project"
        },
        "dotnetPulse.buildBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Build the project before starting it with Run or Debug. This does not affect the Build Project or Build Solution commands."
        },
        "dotnetPulse.projectBuildToConsole": {
          "type": "string",
          "default": "internalConsole",
          "enum": [
            "internalConsole",
            "integratedTerminal",
            "externalTerminal"
          ],
          "description": "Specifies where the project output should be displayed when building or running"
        },
        "dotnetPulse.startConfiguration": {
          "type": "object",
          "default": {},
          "description": "Overrides for the debug/run configuration used by 'Start without Debugging' and 'Start New Instance'. Only the listed properties are honored; any other key is ignored. Unspecified values keep their built-in defaults.",
          "properties": {
            "type": {
              "type": "string",
              "description": "Debug adapter type (e.g. 'coreclr', 'blazorwasm')."
            },
            "request": {
              "type": "string",
              "enum": [
                "launch",
                "attach"
              ],
              "description": "Debug request type."
            },
            "program": {
              "type": "string",
              "description": "Path to the program to launch. Overrides the auto-detected DLL path."
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Command line arguments passed to the program."
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for the launched program."
            },
            "stopAtEntry": {
              "type": "boolean",
              "description": "Whether to stop at the program entry point."
            },
            "requireExactSource": {
              "type": "boolean",
              "description": "Whether to require exact source matching when setting breakpoints."
            },
            "noDebug": {
              "type": "boolean",
              "description": "Whether to launch without attaching the debugger."
            }
          },
          "additionalProperties": false
        },
        "dotnetPulse.buildSuccessSound": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a sound file to play when a build succeeds. Leave empty to disable. Cross-platform: Windows uses PowerShell SoundPlayer (.wav), macOS uses afplay, Linux uses paplay/aplay/ffplay. Example (Windows): C:/Windows/Media/Windows Exclamation.wav. Example (macOS): /System/Library/Sounds/Glass.aiff."
        },
        "dotnetPulse.buildFailureSound": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a sound file to play when a build fails. Leave empty to disable. Cross-platform: Windows uses PowerShell SoundPlayer (.wav), macOS uses afplay, Linux uses paplay/aplay/ffplay. Example (Windows): C:/Windows/Media/Windows Critical Stop.wav. Example (macOS): /System/Library/Sounds/Basso.aiff."
        },
        "dotnetPulse.documentationUrls": {
          "type": "array",
          "default": [],
          "description": "List of documentation URLs to show in the Open Documentation command",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Display name for the documentation link"
              },
              "url": {
                "type": "string",
                "description": "URL of the documentation"
              }
            },
            "required": [
              "label",
              "url"
            ]
          }
        }
      }
    },
    "configurationDefaults": {
      "editor.mouseWheelZoom": true,
      "editor.fontFamily": "'Cascadia Mono', Consolas, 'Courier New', monospace",
      "editor.tabSize": 2,
      "workbench.iconTheme": "vscode-icons",
      "vsicons.presets.foldersAllDefaultIcon": true,
      "editor.aiStats.enabled": true,
      "chat.agent.maxRequests": 1000,
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.razor": "${capture}.razor.cs, ${capture}.razor.css, ${capture}.razor.scss, ${capture}.razor.js, ${capture}.razor.ts, ${capture}.*.verified.razor.html, ${capture}.*.received.razor.html",
        "*.cs": "${capture}.*.cs, ${capture}.Designer.cs, ${capture}.designer.cs, ${capture}.generated.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.aspx": "${capture}.aspx.cs, ${capture}.aspx.designer.cs",
        "*.ascx": "${capture}.ascx.cs, ${capture}.ascx.designer.cs",
        "*.master": "${capture}.master.cs, ${capture}.master.designer.cs",
        "*.resx": "${capture}.Designer.cs, ${capture}.designer.cs",
        "*.html": "${capture}.*.html, ${capture}.html.css, ${capture}.html.js, ${capture}.html.ts",
        "*.htm": "${capture}.*.htm, ${capture}.htm.css, ${capture}.htm.js, ${capture}.htm.ts",
        "*.css": "${capture}.css.map, ${capture}.min.css",
        "*.scss": "${capture}.css, ${capture}.css.map, ${capture}.min.css",
        "*.sass": "${capture}.css, ${capture}.css.map, ${capture}.min.css",
        "*.less": "${capture}.css, ${capture}.css.map, ${capture}.min.css",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map, ${capture}.min.js",
        "*.tsx": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
        "*.jsx": "${capture}.js",
        "*.csproj": "${capture}.csproj.user, ${capture}.csproj.nuget.dgspec.json, ${capture}.csproj.nuget.g.props, ${capture}.csproj.nuget.g.targets",
        "*.vbproj": "${capture}.vbproj.user",
        "*.fsproj": "${capture}.fsproj.user",
        "*.vcxproj": "${capture}.vcxproj.filters, ${capture}.vcxproj.user",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "packages.config": "packages.lock.json",
        "appsettings.json": "appsettings.*.json",
        "web.config": "web.*.config",
        "app.config": "app.*.config",
        ".editorconfig": ".editorconfig.*",
        ".eslintrc.js": ".eslintrc.*, .eslintignore",
        ".eslintrc.json": ".eslintrc.*, .eslintignore",
        ".eslintrc.yml": ".eslintrc.*, .eslintignore",
        ".prettierrc": ".prettierrc.*, .prettierignore",
        "webpack.config.js": "webpack.config.*, webpack.*.config.js"
      }
    },
    "commands": [
      {
        "command": "externalTerminal.openInTerminal",
        "title": "Open in External Terminal.",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.buildProject",
        "title": "Build",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.buildSolution",
        "title": "Build Solution",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.runProject",
        "title": "Start without Debugging",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.debugProject",
        "title": "Start New Instance",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.navigateToCodeBehind",
        "title": "Navigate to Code-Behind File",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.gitCompareWithUnmodified",
        "title": "Git: Compare with unmodified",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.gitViewHistory",
        "title": "Git: View history",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.gitConfigUser",
        "title": "Git: Repository User",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.openDocumentation",
        "title": "Open Documentation",
        "category": ".NET Pulse"
      },
      {
        "command": "netpulse.dotnetHost.list",
        "title": "List",
        "category": ".NET Pulse: .NET Host"
      },
      {
        "command": "netpulse.dotnetHost.killAll",
        "title": "Kill all",
        "category": ".NET Pulse: .NET Host"
      }
    ],
    "submenus": [
      {
        "id": "netpulse.submenu",
        "label": ".NET Pulse"
      },
      {
        "id": "netpulse.dotnetHostSubmenu",
        "label": ".NET Host"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "netpulse.submenu",
          "group": "navigation@10"
        }
      ],
      "netpulse.submenu": [
        {
          "command": "netpulse.buildProject",
          "group": "1_build"
        },
        {
          "command": "netpulse.buildSolution",
          "group": "1_build"
        },
        {
          "command": "netpulse.runProject",
          "group": "1_build"
        },
        {
          "command": "netpulse.debugProject",
          "group": "1_build"
        },
        {
          "submenu": "netpulse.dotnetHostSubmenu",
          "group": "2_host",
          "when": "isWindows"
        },
        {
          "command": "externalTerminal.openInTerminal",
          "group": "3_terminal",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "netpulse.gitCompareWithUnmodified",
          "group": "4_git",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "netpulse.gitViewHistory",
          "group": "4_git",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "netpulse.gitConfigUser",
          "group": "4_git"
        },
        {
          "command": "netpulse.openDocumentation",
          "group": "5_documentation",
          "when": "netpulse.hasDocumentationUrls"
        }
      ],
      "netpulse.dotnetHostSubmenu": [
        {
          "command": "netpulse.dotnetHost.list",
          "group": "1_processes"
        },
        {
          "command": "netpulse.dotnetHost.killAll",
          "group": "2_processes"
        }
      ]
    },
    "keybindings": [
      {
        "command": "-workbench.debug.viewlet.action.addFunctionBreakpointAction",
        "key": "ctrl+b",
        "mac": "cmd+b"
      },
      {
        "command": "-editor.action.smartSelect.expand",
        "key": "ctrl+w",
        "mac": "cmd+w"
      },
      {
        "command": "-editor.action.triggerSuggest",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "externalTerminal.openInTerminal",
        "key": "ctrl+alt+space",
        "mac": "ctrl+alt+space",
        "when": "editorFocus || explorerViewletFocus"
      },
      {
        "command": "netpulse.buildProject",
        "key": "ctrl+b",
        "mac": "cmd+b"
      },
      {
        "command": "netpulse.buildSolution",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "netpulse.runProject",
        "key": "ctrl+f5",
        "mac": "cmd+f5"
      },
      {
        "command": "netpulse.debugProject",
        "key": "f5",
        "when": "!inDebugMode"
      },
      {
        "command": "netpulse.navigateToCodeBehind",
        "key": "f7",
        "when": "editorTextFocus"
      },
      {
        "command": "explorer.newFile",
        "key": "shift+f2"
      },
      {
        "command": "workbench.view.scm",
        "key": "ctrl+alt+p"
      },
      {
        "command": "workbench.view.testing.focus",
        "key": "ctrl+alt+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^9.0.0"
  }
}
